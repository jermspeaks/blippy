# Database (SQLite). Use .env or .env.local for local overrides.
DATABASE_URL="file:./blippy.db"

# AI link import (Capture page). Choose provider/model in Settings; set the key for your provider.
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Book space: Google Books lookups (cover, author, details). Without it, Open Library is used.
GOOGLE_BOOKS_API_KEY=""

# Code space: optional GitHub token (no scopes needed) to raise the repo lookup limit from 60 to 5000/hour.
GITHUB_TOKEN=""
